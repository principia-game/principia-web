{% extends "_layout.twig" %}

{% set title = "Download Principia" %}
{% set description = "Download the latest version of Principia for Windows, Linux, Android and more." %}


{% set version = '2026.09.19' %}
{% set dlurl = 'https://github.com/Bithack/principia/releases/download/'~ version %}

	{% block content %}
<h1>Download Principia</h1>

<p>
	The latest version of Principia is <strong>{{ version }}</strong>.
	You can see what is new in this release in the <a href="/wiki/Changelog#{{ version }}">Changelog</a>.
</p>

<p>
	<strong>Problems</strong>, <em>crashes</em> or <u>bugs</u>? Ask in <a href="/discord">the Discord server</a>,
	<a href="/fluxer">the Fluxer community</a> or on <a href="/forum/">the forums</a>, or
	<a href="https://github.com/Bithack/principia/issues">open an issue on Github</a>.
</p>

{% macro platform_tab(platform, icon, text, active = false) %}
	<button class="tab{% if active %} active{% endif %}" type="button" data-platform="{{ platform }}">
		{{ icon | raw }}
		<span>{{ text }}</span>
	</button>
{% endmacro %}

<div class="platform-tabs" aria-label="Platform">
	{{ _self.platform_tab("windows", '<img src="/icons/windows.svg" alt="">', "Windows", true) }}
	{{ _self.platform_tab("linux", '<img src="/icons/linux.svg?v=2" alt="">', "Linux", false) }}
	{{ _self.platform_tab("android", '<img src="/icons/android.svg?v=2" alt="">', "Android", false) }}
	{{ _self.platform_tab("web", '<img src="/icons/chrome.svg" alt="">', "Web", false) }}
	{{ _self.platform_tab("macos", icon("apple"), "macOS", false) }}
	{{ _self.platform_tab("haiku", '<img src="/icons/haiku.svg" alt="">', "Haiku", false) }}
	{{ _self.platform_tab("other", icon("dots-horizontal"), "More", false) }}
</div>

<!-- Windows -->
<section class="dl-panel active" data-platform-panel="windows">
	<div class="panel-head">
		<img src="/icons/windows.svg" alt="">
		<div>
			<h2>Windows</h2>
			<p>Windows 10 and above (older may work but is not supported)</p>
		</div>
	</div>

	<div class="download-btns">
		<a class="download-btn primary" href="{{ dlurl }}/principia_{{ version }}_win64.exe">
			<span class="btn-icon">{{ icon("download") }}</span>
			<span class="btn-content">
				<strong>Windows Installer</strong>
				<small>64-bit - Recommended</small>
			</span>
		</a>

		<a class="download-btn" href="{{ dlurl }}/principia_{{ version }}_win64.7z">
			<span class="btn-icon">{{ icon("download") }}</span>
			<span class="btn-content">
				<strong>Portable version</strong>
				<small>64-bit - No installation required</small>
			</span>
		</a>
	</div>

	<p>
		The portable build has some limitations that are important to know about.
		See <a href="/wiki/Windows_Portable">Windows Portable</a> for more information.
	</p>

	<hr>

	<div class="download-btns">
		<a class="download-btn primary" href="{{ dlurl }}/principia_{{ version }}_win32.exe">
			<span class="btn-icon">{{ icon("download") }}</span>
			<span class="btn-content">
				<strong>Windows Installer</strong>
				<small>32-bit - For older devices</small>
			</span>
		</a>

		<a class="download-btn" href="{{ dlurl }}/principia_{{ version }}_win32.7z">
			<span class="btn-icon">{{ icon("download") }}</span>
			<span class="btn-content">
				<strong>Portable version</strong>
				<small>32-bit - For older devices</small>
			</span>
		</a>
	</div>
</section>

<!-- Android -->
<section class="dl-panel" data-platform-panel="android">
	<div class="panel-head">
		<img src="/icons/android.svg?v=2" alt="">
		<div>
			<h2>Android</h2>
			<p>Android 5.0 and newer</p>
		</div>
	</div>

	<a class="download-btn primary" href="{{ dlurl }}/principia_{{ version }}.apk">
		<span class="btn-icon">{{ icon("download") }}</span>
		<span class="btn-content">
			<strong>Direct APK download</strong>
			<small>Universal APK (ARM 32-bit, ARM 64-bit & x86_64)</small>
		</span>
	</a>

	<hr>

	<h3>F-Droid</h3>
	<p>
		Principia is also available on F-Droid.
	</p>

	<a href="https://f-droid.org/packages/com.bithack.principia/">
		<img src="/assets/fdroid.png" alt="Get it on F-Droid" height="80">
	</a>

	<p>
		Keep in mind that the F-Droid build uses a different signing key,
		which means that if you want to switch distribution channels you'll need to
		fully uninstall Principia before installing the new version.
		Please back up your user data before doing so.
	</p>
</section>

<!-- Linux -->
<section class="dl-panel" data-platform-panel="linux">
	<div class="panel-head">
		<img src="/icons/linux.svg?v=2" alt="">
		<div>
			<h2>Linux</h2>
			<p>Choose the installation method for your distribution</p>
		</div>
	</div>

	<!-- AppImage -->
	<div class="dl-subsection first-child">
		<div class="sub-icon">
			<img src="/icons/appimage.svg" alt="AppImage">
		</div>

		<div class="sub-content">
			<h3>AppImage</h3>
			<p>
				Cross-distribution binary in one file.
			</p>

			<div class="download-btns">
				<a class="download-btn primary" href="{{ dlurl }}/principia_{{ version }}_x86_64.AppImage">
					<span class="btn-icon">{{ icon("download") }}</span>
					<span class="btn-content">
						<strong>AppImage</strong>
						<small>x86_64 - for glibc-based distributions released ~2021 & onward</small>
					</span>
				</a>

				{#
				<a class="download-btn" href="{{ dlurl }}/principia_{{ version }}_aarch64.AppImage">
					<span class="btn-icon">{{ icon("download") }}</span>
					<span class="btn-content">
						<strong>AppImage</strong>
						<small>aarch64 - for glibc-based distributions released ~2021 & onward</small>
					</span>
				</a>#}
			</div>

			<p class="download-note">
				<strong>xdg-utils</strong> and functional OpenGL drivers must also
				be installed.

				<a href="https://docs.appimage.org/introduction/quickstart.html#ref-how-to-run-appimage">
					How to run an AppImage?
				</a>
			</p>
		</div>
	</div>

	<!-- Arch Linux -->
	<div class="dl-subsection">
		<div class="sub-icon">
			<img src="/icons/arch.svg" alt="Arch Linux">
		</div>

		<div class="sub-content">
			<h3>Arch Linux</h3>
			<p>Packages for Principia are available in the Arch User Repository (AUR):</p>

			<ul>
				<li>
					<a href="https://aur.archlinux.org/packages/principia"><code>principia</code></a> - stable release
				</li>
				<li>
					<a href="https://aur.archlinux.org/packages/principia-git"><code>principia-git</code></a> - latest master branch
				</li>
			</ul>

			<p>
				A <a href="https://arch.principia-web.se/">custom binary repository</a> with prebuilt packages is also available. To add:
			</p>

			<pre><code>echo -e '\n[principia]\nSigLevel = Optional DatabaseOptional\nServer = https://arch.principia-web.se/$arch' | sudo tee -a /etc/pacman.conf</code></pre>
		</div>
	</div>

	<!-- NixOS -->
	<div class="dl-subsection">
		<div class="sub-icon">
			<img src="/icons/nix.svg" alt="NixOS">
		</div>

		<div class="sub-content">
			<h3>NixOS</h3>
			<p>A package for Principia <a href="https://search.nixos.org/packages?channel=unstable&show=principia">is available in nixpkgs</a>.</p>
		</div>
	</div>

	<!-- Alpine -->
	<div class="dl-subsection">
		<div class="sub-icon">
			<img src="/icons/alpine.svg" alt="Alpine Linux">
		</div>

		<div class="sub-content">
			<h3>Alpine</h3>

			<p>
				A package for Principia <a href="https://pkgs.alpinelinux.org/packages?name=principia&branch=edge&arch=">is available in the testing repository of Alpine edge</a>.
			</p>
		</div>
	</div>

	<!-- Slackware -->
	<div class="dl-subsection">
		<div class="sub-icon">
			<img src="/icons/slackware.svg" alt="Slackware">
		</div>

		<div class="sub-content">
			<h3>Slackware</h3>

			<p>
				A package for Principia <a href="https://slackbuilds.org/repository/15.0/games/principia/">is available in SlackBuilds</a>.
			</p>
		</div>
	</div>

	<!-- Other -->
	<div class="dl-subsection">
		<div class="sub-icon generic">
			?
		</div>

		<div class="sub-content">
			<h3>Other</h3>
			<p>Build Principia from source.</p>

			<p class="download-note">
				Compilation instructions can be found on the
				<a href="/wiki/Compiling_Principia">
					Compiling Principia
				</a>
				wiki page.
			</p>

			<div class="download-btns">
				<a class="download-btn" href="https://github.com/Bithack/principia/archive/refs/tags/{{ version }}.tar.gz">
					<span class="btn-icon">{{ icon("download") }}</span>
					<span class="btn-content">
						<strong>Principia source code</strong>
						<small>.tar.gz</small>
					</span>
				</a>
			</div>

			<p>Alternatively clone the Git repository and build from source <strong>(this will clone latest master)</strong>:</p>

			<pre><code>git clone --depth 1 https://github.com/Bithack/principia</code></pre>
		</div>
	</div>

</section>

<!-- Web -->
<section class="dl-panel" data-platform-panel="web">
	<div class="panel-head">
		<img src="/icons/chrome.svg" alt="">
		<div>
			<h2>Web</h2>
			<p>Play Principia directly in your browser</p>
		</div>
	</div>

	<a class="download-btn primary" href="/play">
		<span class="btn-icon">{{ icon("play") }}</span>
		<span class="btn-content">
			<strong>Play Principia in your browser</strong>
			<small>Build levels in your browser</small>
		</span>
	</a>

	<p>
		The web version of Principia is still experimental.
	</p>

	<p>
		You can play
		community levels directly in your browser by choosing Web when
		pressing play on the community site.
	</p>

	<div class="web-instructions">
		<img src="/assets/web_play_1.webp" class="instruction img-responsive" style="width: 500px">
		<img src="/assets/web_play_2.webp" class="instruction img-responsive" style="width: 500px">
	</div>
</section>

<!-- macOS -->
<section class="dl-panel" data-platform-panel="macos">
	<div class="panel-head">
		{{ icon("apple") }}
		<div>
			<h2>macOS</h2>
			<p>Experimental port</p>
		</div>
	</div>

	<p>
		A very experimental port to macOS is available. If you have Mac hardware
		and are willing to test whether Principia works on macOS, feedback is
		appreciated.
	</p>

	<a class="download-btn primary" href="https://nightly.link/Bithack/principia/workflows/macos/master/principia-macos.zip">
		<span class="btn-icon">{{ icon("download") }}</span>
		<span class="btn-content">
			<strong>Download macOS build</strong>
			<small>Latest nightly build</small>
		</span>
	</a>

	<p class="download-note">
		Alternatively, compile from source using the
		<a href="/wiki/Compiling_Principia#macos">macOS compilation instructions</a>.
	</p>
</section>


<!-- Haiku -->
<section class="dl-panel" data-platform-panel="haiku">
	<div class="panel-head">
		<img src="/icons/haiku.svg" alt="">
		<div>
			<h2>Haiku</h2>
			<p>Experimental port</p>
		</div>
	</div>

	<p>
		An experimental port to Haiku OS is available for Principia.
	</p>

	<p>
		For instructions on how to compile and run Principia on Haiku OS see
		<a href="/wiki/Compiling_Principia#haiku-os">Compiling Principia</a>.
	</p>
</section>

<!-- More -->
<section class="dl-panel" data-platform-panel="other">
	<div class="panel-head">
		{{ icon("dots-horizontal") }}
		<div>
			<h2>More</h2>
			<p>Other download options</p>
		</div>
	</div>

	<div class="dl-subsection first-child">
		<div class="sub-icon">
			<img src="/icons/windows_colorful.svg" alt="">
		</div>

		<div class="sub-content">
			<h3>Windows XP</h3>
			<p>Experimental builds of Principia are available for Windows XP.</p>

			<a class="download-btn primary" href="https://github.com/rollerozxa/principia-xp/releases">
				<span class="btn-icon">{{ icon("download") }}</span>
				<span class="btn-content">
					<strong>Go to Windows XP releases</strong>
					<small>Installer & portable available</small>
				</span>
			</a>
		</div>
	</div>

	<div class="dl-subsection">
		<div class="sub-icon">
			{{ icon("itch") }}
		</div>

		<div class="sub-content">
			<h3>itch.io</h3>
			<p>
				Principia is available to download on itch.io, either for free or for a fee to support the project.
			</p>

			<a href="https://rollerozxa.itch.io/principia">
				<img src="/assets/itch.svg" alt="Available on itch.io" style="width:250px" class="img-responsive">
			</a>
		</div>
	</div>

	<div class="dl-subsection">
		<div class="sub-icon">
			{{ icon("wizard-hat")}}
		</div>

		<div class="sub-content">
			<h3>Nightly builds</h3>
			<p>
				Whenever a new commit is pushed the game is automatically built by CI for all supported platforms.
				These nightly builds contain changes that have not yet made it into a full release,
				but are also less tested than the release builds.
			</p>

			<p>
				For more information and downloads see the <a href="/wiki/Nightly_Builds">Nightly Builds page</a>.
			</p>
		</div>
	</div>

	<div class="dl-subsection">
		<div class="sub-icon">
			{{ icon("root")}}
		</div>

		<div class="sub-content">
			<h3>Source code</h3>

			<p>
				The source code for Principia is hosted on <a href="https://github.com/Bithack/principia">Github</a>
				with a read-only mirror available on <a href="https://codeberg.org/principia/principia">Codeberg</a>.
			</p>

			<p>
				For instructions on how to compile Principia from source see the
				<a href="/wiki/Compiling_Principia">Compiling Principia</a> page on the Principia Wiki.
			</p>
		</div>
	</div>
</section>

<script src="/js/downloads.js"></script>
	{% endblock %}
